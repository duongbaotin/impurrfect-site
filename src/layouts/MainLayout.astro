---
// src/layouts/MainLayout.astro
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ImageViewer from '../components/lightbox/ImageViewer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import faviconSvg from '../assets/images/favicon.svg?url';

interface Props {
  title?: string;
  description?: string;
  allergyNotice?: boolean;
}

const { title = "impurrfect", description, allergyNotice } = Astro.props;
const ogImage = new URL('/og-image.svg', Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={Astro.url} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <title>{title}</title>
    {description && (
      <>
        <meta name="description" content={description} />
        <meta property="og:description" content={description} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <Analytics />
    <SpeedInsights />
  </head>
  
  <body class="bg-night text-cream min-h-screen selection:bg-charcoal">

    <a href="#main-content" class="skip-link">Skip to content</a>

    <Nav />
    
    <main id="main-content" class="max-w-2xl mx-auto px-6 py-12 md:py-20 animate-fade-in">
      <slot />
    </main>

    <Footer allergyNotice={allergyNotice} />

    <!-- Image Viewer (singleton) -->
    <ImageViewer />

  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    z-index: 999;
    padding: 8px 16px;
    background: var(--color-gold);
    color: var(--color-cream);
    font-size: 14px;
    text-decoration: none;
    transition: top 0.1s;
  }

  .skip-link:focus {
    top: 0;
  }

  .font-accent {
    font-family: 'Freight Big Pro', 'Playfair Display', Georgia, serif;
    font-style: italic;
  }

  @media print {
    nav, .skip-link, footer { display: none !important; }
    body { background: white !important; color: black !important; }
    main { max-width: 100% !important; padding: 0 !important; }
    .font-display { font-family: Georgia, serif !important; }
    .font-body { font-family: sans-serif !important; }
    .font-accent { font-family: Georgia, serif !important; font-style: italic !important; }
  }
</style>