---
import MenuItem from './MenuItem.astro';
import type { MenuCategoryData } from '../data/menu';

interface Props {
  category: MenuCategoryData;
}

const { category: cat } = Astro.props;
---

<section class="space-y-8">
  <div class="border-b border-[#33363A] pb-2">
    <h2 class="font-display text-xl md:text-2xl text-[#875A2A] tracking-wider uppercase">
      {cat.category}
    </h2>
    {cat.description && (
      <p class="font-accent text-stone-400 text-xs md:text-sm mt-1">
        {cat.description}
      </p>
    )}
  </div>
  <div class="space-y-6">
    {cat.items.map((item) => (
      <MenuItem item={item} />
    ))}
  </div>
</section>
