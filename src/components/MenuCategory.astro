---
import MenuItem from './MenuItem.astro';
import type { MenuCategoryData } from '../data/menu';

interface Props {
  category: MenuCategoryData;
}

const { category: cat } = Astro.props;

const grouped = new Map<string, typeof cat.items>();
const ungrouped: typeof cat.items = [];

for (const item of cat.items) {
  if (item.subcategory) {
    const group = grouped.get(item.subcategory) ?? [];
    group.push(item);
    grouped.set(item.subcategory, group);
  } else {
    ungrouped.push(item);
  }
}
const sortedGroups = [...grouped.entries()];
---

<section class="space-y-8">
  <div class="border-b border-charcoal pb-2">
    <h2 class="font-display text-xl md:text-2xl text-gold tracking-wider uppercase">
      {cat.category}
    </h2>
    {cat.description && (
      <p class="font-accent text-stone-400 text-xs md:text-sm mt-1">
        {cat.description}
      </p>
    )}
  </div>
  <div class="space-y-6">
    {ungrouped.map((item) => <MenuItem item={item} />)}
    {sortedGroups.map(([sub, items]) => (
      <div class="space-y-4">
        <h3 class="font-display text-xs uppercase tracking-widest text-gold/70 border-b border-charcoal/50 pb-1">
          {sub}
        </h3>
        <div class="space-y-5">
          {items.map((item) => <MenuItem item={item} />)}
        </div>
      </div>
    ))}
  </div>
</section>
