---
interface Props {
  allergyNotice?: boolean;
}

import BrandNameWord from './BrandNameWord.astro';
const { allergyNotice = true } = Astro.props;
---

<footer class="mt-24 pt-8 pb-8 md:pb-12 border-t border-charcoal text-center space-y-2 text-[10px] text-stone-500 font-body tracking-widest">
  {allergyNotice && (
    <p class="uppercase">Please inform your bartender of any allergies.</p>
  )}
  <p>
    © {new Date().getFullYear()} <span class="font-display text-cream"><BrandNameWord /></span>.
  </p>
  <div class="flex justify-center gap-3 pt-2">
    <a href="https://instagram.com/impurrfect.bar" target="_blank" rel="noopener noreferrer" class="hover:text-cream transition-colors duration-200 no-underline">
      Instagram
    </a>
    <span class="text-charcoal">·</span>
    <a href="https://facebook.com/impurrfect.bar" target="_blank" rel="noopener noreferrer" class="hover:text-cream transition-colors duration-200 no-underline">
      Facebook
    </a>
  </div>
</footer>
