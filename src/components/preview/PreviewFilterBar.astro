---
import type { MenuMood, MenuSpirit } from '../../data/menu-moods';

interface Props {
  categories: { name: string; count: number }[];
  moods: MenuMood[];
  spirits: MenuSpirit[];
}

const { categories, moods, spirits } = Astro.props;

const categoryShortLabels: Record<string, string> = {
  all: 'All',
  Signature: 'Signature',
  'Zero Alcohol': 'Zero Alcohol',
  Cocktails: 'Cocktails',
  'Mixed Beers': 'Beers',
  Snacks: 'Snacks',
};

const tabs = [
  { key: 'all', label: 'All' },
  ...categories.map((category) => ({
    key: category.name,
    label: categoryShortLabels[category.name] ?? category.name,
  })),
];
---

<div
  class="pv-filterbar sticky top-0 z-30 -mx-6 px-6 py-2.5"
  @keydown.escape.window="openDrawer = null"
>
  <div class="flex flex-col gap-2">
    <!-- Zero-scroll category tabs (3x2 mobile, 6 desktop) -->
    <div
      class="grid grid-cols-3 sm:grid-cols-6 gap-1.5"
      role="group"
      aria-label="Filter by category"
    >
      {tabs.map((tab) => (
        <button
          type="button"
          class="pv-tab text-center rounded-full px-1 py-1 font-body text-[10px] sm:text-[11px] uppercase tracking-wider truncate"
          :data-active={`activeCategory === ${JSON.stringify(tab.key)}`}
          :aria-pressed={`activeCategory === ${JSON.stringify(tab.key)}`}
          @click={`setCategory(${JSON.stringify(tab.key)})`}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Taste & Spirit filter trigger bar & collapsible drawers -->
    <div
      class="relative"
      x-show="activeCategory !== 'Snacks'"
      x-cloak
      @click.outside="openDrawer = null"
    >
      <div class="flex items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          <!-- Taste trigger -->
          <button
            type="button"
            class="pv-taste-trigger inline-flex items-center gap-1 rounded-full px-2.5 py-1 font-body text-[10px] sm:text-[11px] uppercase tracking-wider transition-colors"
            x-show="hasAvailableMoods"
            :data-active="activeMood !== null"
            :aria-expanded="openDrawer === 'taste'"
            @click="toggleDrawer('taste')"
          >
            <span x-show="!activeMood">Taste</span>
            <span x-show="activeMood" x-cloak>
              Taste: <span x-text="activeMoodLabel"></span>
            </span>
            <svg
              class="h-3 w-3 shrink-0 transition-transform duration-200"
              :class="openDrawer === 'taste' && 'rotate-180'"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
            </svg>
          </button>

          <!-- Base Spirit trigger: visible when spirits are available for active category/taste -->
          <button
            type="button"
            class="pv-taste-trigger inline-flex items-center gap-1 rounded-full px-2.5 py-1 font-body text-[10px] sm:text-[11px] uppercase tracking-wider transition-colors"
            x-show="hasAvailableSpirits"
            :data-active="activeSpirit !== null"
            :aria-expanded="openDrawer === 'spirit'"
            @click="toggleDrawer('spirit')"
          >
            <span x-show="!activeSpirit">Spirit</span>
            <span x-show="activeSpirit" x-cloak>
              Spirit: <span x-text="activeSpiritLabel"></span>
            </span>
            <svg
              class="h-3 w-3 shrink-0 transition-transform duration-200"
              :class="openDrawer === 'spirit' && 'rotate-180'"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
            </svg>
          </button>

          <!-- Clear button when either filter is active -->
          <button
            type="button"
            class="font-body text-[10px] uppercase tracking-wider text-[var(--pv-accent)] hover:underline ml-1"
            x-show="activeMood !== null || activeSpirit !== null"
            x-cloak
            @click="clearDrinkFilters()"
            aria-label="Clear drink filters"
          >
            Clear ✕
          </button>
        </div>

        <div
          class="font-body text-[10px] tracking-wide text-[var(--pv-muted)] shrink-0"
          x-show="isFiltered"
          x-cloak
        >
          Showing <span class="font-medium text-[var(--pv-text)]" x-text="visibleCount">0</span> drinks
        </div>
      </div>

      <!-- 2-column Taste drawer -->
      <div
        class="pv-taste-drawer pt-2"
        x-show="openDrawer === 'taste'"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 -translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-100"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-1"
        x-cloak
        role="region"
        aria-label="Taste filters"
      >
        <div class="grid grid-cols-2 gap-2 pt-1 pb-1">
          {moods.map((mood) => (
            <button
              type="button"
              class="pv-pill flex items-center justify-between rounded-lg px-2.5 py-1.5 text-left font-body text-[10px] uppercase tracking-wider sm:px-3 sm:py-2 sm:text-[11px]"
              x-show={`isMoodAvailable(${JSON.stringify(mood.key)})`}
              :data-active={`activeMood === ${JSON.stringify(mood.key)}`}
              :aria-pressed={`activeMood === ${JSON.stringify(mood.key)}`}
              @click={`toggleMood(${JSON.stringify(mood.key)})`}
            >
              <span class="truncate">{mood.label}</span>
              <span
                class="ml-1 text-[var(--pv-accent)] font-semibold"
                x-show={`activeMood === ${JSON.stringify(mood.key)}`}
                x-cloak
              >
                ✓
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- 2-column Spirit drawer -->
      <div
        class="pv-taste-drawer pt-2"
        x-show="openDrawer === 'spirit'"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 -translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-100"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-1"
        x-cloak
        role="region"
        aria-label="Base spirit filters"
      >
        <div class="grid grid-cols-2 gap-2 pt-1 pb-1">
          {spirits.map((spirit) => (
            <button
              type="button"
              class="pv-pill flex items-center justify-between rounded-lg px-2.5 py-1.5 text-left font-body text-[10px] uppercase tracking-wider sm:px-3 sm:py-2 sm:text-[11px]"
              x-show={`isSpiritAvailable(${JSON.stringify(spirit.key)})`}
              :data-active={`activeSpirit === ${JSON.stringify(spirit.key)}`}
              :aria-pressed={`activeSpirit === ${JSON.stringify(spirit.key)}`}
              @click={`toggleSpirit(${JSON.stringify(spirit.key)})`}
            >
              <span class="truncate">{spirit.label}</span>
              <span
                class="ml-1 text-[var(--pv-accent)] font-semibold"
                x-show={`activeSpirit === ${JSON.stringify(spirit.key)}`}
                x-cloak
              >
                ✓
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
