---
// Preview-only control. Theme state lives in the `menuPreview` Alpine component.
---

<div class="pv-theme-switch" role="group" aria-label="Preview theme">
  <button
    type="button"
    class="pv-theme-seg font-body text-[11px] uppercase tracking-widest"
    :data-active="theme === 'dark'"
    :aria-pressed="theme === 'dark'"
    aria-label="Dark mode"
    @click="setTheme('dark')"
  >
    🌙 Dark
  </button>
  <button
    type="button"
    class="pv-theme-seg font-body text-[11px] uppercase tracking-widest"
    :data-active="theme === 'paper'"
    :aria-pressed="theme === 'paper'"
    aria-label="Light mode"
    @click="setTheme('paper')"
  >
    ☀️ Light
  </button>
</div>
