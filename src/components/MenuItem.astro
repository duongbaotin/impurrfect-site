---
import type { MenuItemData } from '../data/menu';

interface Props {
  item: MenuItemData;
}

const { item } = Astro.props;
---

  <div class="group font-body flex gap-4">
    {item.image && (
      <div class="shrink-0 pt-1">
        <img src={item.image} alt="" class="w-10 h-auto opacity-50" aria-hidden="true" />
      </div>
    )}
    <div class="flex-1 min-w-0">
      <div class="flex justify-between items-baseline gap-4 mb-1">
        <h3 class="font-normal text-sm md:text-base text-[#F6F3EF] group-hover:text-[#875A2A] transition-colors duration-200 tracking-wide">
          {item.name}
        </h3>
        <div class="flex items-center gap-2 shrink-0">
          {item.featured && (
            <span class="font-accent text-[9px] text-[#875A2A] tracking-widest uppercase">&#9733; Bartender's Pick</span>
          )}
          <span class="h-[1px] w-4 border-b border-dashed border-[#33363A] hidden sm:block"></span>
          <span class="font-display font-medium text-[#875A2A] text-sm">
            {item.price}
          </span>
        </div>
      </div>
      <p class="text-xs text-stone-400 font-light leading-relaxed max-w-xl">
        {item.description}
      </p>
      {item.tags && item.tags.length > 0 && (
        <div class="flex gap-2 mt-2">
          {item.tags.map((tag) => (
            <span class="inline-block text-[9px] uppercase tracking-widest text-[#875A2A] border border-[#875A2A] px-2 py-[1px] rounded-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
