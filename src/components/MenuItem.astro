---
import type { MenuItemData } from '../data/menu';

interface Props {
  item: MenuItemData;
}

const { item } = Astro.props;
const unavailable = item.available === false;
---

  <div class={`group font-body flex gap-4 items-center${unavailable ? ' opacity-50' : ''}`}>
    {item.image && (
      <div class="shrink-0">
        <img src={item.image} alt="" class="w-10 h-auto opacity-50" aria-hidden="true" />
      </div>
    )}
    <div class="flex-1 min-w-0">
      <div class="flex justify-between items-baseline gap-4 mb-1">
        <h3 class={`font-normal text-sm md:text-base transition-colors duration-200 tracking-wide${unavailable ? ' line-through text-stone-500' : ' text-cream group-hover:text-gold'}${item.featured && !unavailable ? ' featured' : ''}`}>
          {item.name}
          {item.featured && !unavailable && (
            <span class="stamp">House's Pick</span>
          )}
        </h3>
        <div class="flex items-center gap-2 shrink-0">
          <span class="h-[1px] w-4 border-b border-dashed border-charcoal hidden sm:block"></span>
          <span class="font-display font-medium text-gold text-sm">
            {item.price}
          </span>
        </div>
      </div>
      <p class="text-xs text-stone-400 font-light leading-relaxed max-w-xl">
        {item.description}
      </p>
      {item.tags && item.tags.length > 0 && (
        <div class="flex gap-2 mt-2">
          {item.tags.map((tag) => (
            <span class="inline-block text-[9px] uppercase tracking-widest text-gold border border-gold px-2 py-[1px] rounded-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
      {unavailable && (
        <span class="inline-block mt-2 text-[9px] uppercase tracking-widest text-stone-500 border border-dashed border-stone-500 px-2 py-[1px] rounded-sm">
          Currently unavailable
        </span>
      )}
    </div>
</div>

<style>
  h3.featured {
    position: relative;
  }
  h3.featured::after {
    content: '';
    position: absolute;
    left: 1rem;
    bottom: -3px;
    width: 100%;
    border-bottom: 1px dashed var(--color-gold);
  }
  h3.featured .stamp {
    position: absolute;
    left: calc(100% + 1rem + 0.5rem);
    bottom: -5px;
    font-family: var(--font-body);
    font-size: 8px;
    color: var(--color-gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 1px 5px;
    border: 1px solid var(--color-gold);
    opacity: 0.85;
    transform: rotate(-2deg);
  }
</style>
