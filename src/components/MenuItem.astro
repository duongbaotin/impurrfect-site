---
import type { MenuItemData } from '../data/menu';

const imageModules = import.meta.glob('../assets/images/*.{webp,svg}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;

const imageSrcMap: Record<string, string> = {};
for (const [path, src] of Object.entries(imageModules)) {
  const filename = '/' + path.split('/').pop()!;
  imageSrcMap[filename] = src;
}

interface Props {
  item: MenuItemData;
}

const { item } = Astro.props;
const unavailable = item.available === false;
const imgSrc = item.image ? imageSrcMap[item.image] : undefined;
const isPhoto = item.image?.endsWith('.webp') ?? false;
---

  <div class={`group font-body flex gap-4 items-center${unavailable ? ' opacity-50' : ''}`}>
    {imgSrc && (
      <div class="shrink-0">
        {isPhoto ? (
          <div x-data="{
            open: false, activeSrc: '', loading: true,
            touchStartY: 0, swipeY: 0, swiped: false,
            pushedState: false, overflowTimer: null,
            init() {
              window.addEventListener('touchmove', this.onTouchMove.bind(this), { passive: false });
            },
            openLightbox() {
              if (this.open) return;
              this.open = true;
              this.activeSrc = this.$refs.thumb.src;
              this.swiped = false;
              this.loading = true;
              clearTimeout(this.overflowTimer);
              document.body.style.overflow = 'hidden';
              history.pushState({ lightbox: true }, '');
              this.pushedState = true;
              this.$nextTick(() => { this.$refs.overlay.querySelector('button').focus(); });
            },
            closeLightbox(fromPopstate) {
              if (!this.open) return;
              this.open = false;
              this.activeSrc = '';
              this.loading = true;
              this.swipeY = 0;
              this.swiped = false;
              if (this.pushedState && !fromPopstate) history.back();
              this.pushedState = false;
              clearTimeout(this.overflowTimer);
              this.overflowTimer = setTimeout(() => {
                if (!this.open && !$store.mobileNav.open) document.body.style.overflow = '';
              }, 160);
              if (this.$refs.thumb) this.$refs.thumb.focus();
            },
            onTouchStart(e) {
              this.touchStartY = e.touches[0].clientY;
              this.swiped = false;
            },
            onTouchMove(e) {
              if (!this.open) return;
              const dy = e.touches[0].clientY - this.touchStartY;
              if (dy > 0) e.preventDefault();
              if (dy > 10) {
                this.swiped = true;
                this.swipeY = dy;
                this.$refs.img.style.transition = 'none';
                this.$refs.img.style.transform = 'translateY(' + dy + 'px)';
                this.$refs.img.style.opacity = Math.max(0, 1 - dy / 300);
              }
            },
            onTouchEnd() {
              if (this.swipeY > 100) this.closeLightbox();
              else {
                this.$refs.img.style.transition = 'transform 0.2s ease, opacity 0.2s ease';
                this.$refs.img.style.transform = '';
                this.$refs.img.style.opacity = '';
                this.swipeY = 0;
                this.swiped = false;
              }
            },
            onKeydown(e) {
              if (!this.open || e.key !== 'Tab') return;
              const focusables = this.$refs.overlay.querySelectorAll('button, [href], img');
              if (!focusables.length) return;
              const first = focusables[0];
              const last = focusables[focusables.length - 1];
              if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
              } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
              }
            }
          }">
            <img x-ref="thumb" src={imgSrc} alt={item.name}
              class="w-20 sm:w-32 h-auto opacity-100 cursor-pointer transition-opacity hover:opacity-80"
              @click="openLightbox()" />

            <template x-teleport="body">
              <div x-show="open" x-cloak x-ref="overlay"
                   x-transition.opacity.duration.150ms
                   x-init="$watch('open', val => { if (val) loading = true; else activeSrc = ''; })"
                   @click="closeLightbox()"
                   @keydown.escape.window="closeLightbox()"
                   @popstate.window="closeLightbox(true)"
                   @touchstart="onTouchStart($event)"
                   @touchend="onTouchEnd()"
                   @keydown="onKeydown($event)"
                   role="dialog" aria-modal="true"
                   aria-label={'Image of ' + item.name}
                   class="fixed inset-0 z-50 flex items-center justify-center bg-night/90">
                <div @click.stop x-ref="img" class="relative flex items-center justify-center">
                  <div x-show="loading" class="absolute inset-0 flex items-center justify-center">
                    <div class="w-12 h-12 border-4 border-gold border-t-transparent rounded-full animate-spin"></div>
                  </div>
                  <button @click.stop="closeLightbox()"
                          class="absolute -top-2 -right-2 text-cream text-3xl leading-none p-2 bg-night/50 rounded-full hover:text-gold transition-colors z-10"
                          aria-label="Close">&times;</button>
                  <img x-show="activeSrc.length" :src="activeSrc" alt={item.name} @load="loading = false" @error="loading = false"
                       :class="['max-w-[90vw] max-h-[90vh] object-contain', loading ? 'opacity-0' : 'opacity-100']" />
                </div>
              </div>
            </template>
          </div>
        ) : (
          <img src={imgSrc} alt="" class="w-10 h-auto opacity-50" aria-hidden="true" />
        )}
      </div>
    )}
    <div class="flex-1 min-w-0">
      <div class="flex justify-between items-baseline gap-4 mb-1">
        <h3 class={`font-normal text-sm md:text-base transition-colors duration-200 tracking-wide${unavailable ? ' line-through text-stone-500' : ' text-cream group-hover:text-gold'}${item.featured && !unavailable ? ' featured' : ''}`}>
          {item.name}
          {item.featured && !unavailable && (
            <span class="stamp">staff favorite</span>
          )}
        </h3>
        <span class="flex-1 border-b border-dashed border-gold hidden sm:block"></span>
        <span class="font-display font-medium text-gold text-sm shrink-0">
          {item.price}
        </span>
      </div>
      <p class="text-xs text-stone-400 font-light leading-relaxed max-w-xl">
        {item.description}
      </p>
      {item.tags && item.tags.length > 0 && (
        <div class="flex gap-2 mt-2">
          {item.tags.map((tag) => (
            <span class="inline-block text-[9px] uppercase tracking-widest text-gold border border-gold px-2 py-[1px] rounded-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
      {unavailable && (
        <span class="inline-block mt-2 text-[9px] uppercase tracking-widest text-stone-500 border border-dashed border-stone-500 px-2 py-[1px] rounded-sm">
          Currently unavailable
        </span>
      )}
    </div>
</div>

<style>
  h3.featured .stamp {
    font-family: var(--font-body);
    font-size: 8px;
    color: var(--color-gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 1px 5px;
    border: 1px solid var(--color-gold);
    opacity: 0.85;
    transform: rotate(-2deg);
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
  }
</style>
