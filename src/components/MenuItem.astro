---
import type { MenuItemData } from '../data/menu';

const imageModules = import.meta.glob('../assets/images/*.{webp,svg}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;

const imageSrcMap: Record<string, string> = {};
for (const [path, src] of Object.entries(imageModules)) {
  const filename = '/' + path.split('/').pop()!;
  imageSrcMap[filename] = src;
}

interface Props {
  item: MenuItemData;
}

const { item } = Astro.props;
const unavailable = item.available === false;
const imgSrc = item.image ? imageSrcMap[item.image] : undefined;
const isPhoto = item.image?.endsWith('.webp') ?? false;
const openViewerHandler = imgSrc
  ? `window.dispatchEvent(new CustomEvent('open-viewer', { detail: { url: ${JSON.stringify(imgSrc)}, alt: ${JSON.stringify(item.name)} } }))`
  : undefined;
---

  <div class={`group font-body flex gap-4 items-center${unavailable ? ' opacity-50' : ''}`}>
    {imgSrc && (
      <div class="shrink-0">
        {isPhoto ? (
          <button
            type="button"
            class="relative group shrink-0 block w-20 sm:w-32 focus:outline-none focus:ring-2 focus:ring-cream/50 focus:ring-offset-2 focus:ring-offset-night rounded"
            @click={openViewerHandler}
            aria-label={`View larger image of ${item.name}`}
            disabled={unavailable || undefined}
          >
            <img src={imgSrc} alt={item.name} loading="lazy" decoding="async"
              class:list={[
                "w-full h-auto transition-all duration-200",
                unavailable ? "opacity-30 cursor-not-allowed" : "opacity-100 group-hover:opacity-80 group-focus-visible:opacity-80 cursor-pointer"
              ]}
            />
            {!unavailable && (
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-200">
                <span class="p-2 bg-black/60 rounded-full">
                  <svg class="w-4 h-4 text-cream" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </span>
              </div>
            )}
          </button>
        ) : (
          <img src={imgSrc} alt="" class="w-10 h-auto opacity-50" aria-hidden="true" />
        )}
      </div>
    )}
    <div class="flex-1 min-w-0">
      <div class="flex justify-between items-baseline gap-4 mb-1">
        <h3 class={`font-normal text-sm md:text-base transition-colors duration-200 tracking-wide${unavailable ? ' line-through text-stone-500' : ' text-cream group-hover:text-gold'}${item.featured && !unavailable ? ' featured' : ''}`}>
          {item.name}
          {item.featured && !unavailable && (
            <span class="stamp">staff favorite</span>
          )}
        </h3>
        <span class="flex-1 border-b border-dashed border-gold hidden sm:block"></span>
        <span class="font-display font-medium text-gold text-sm shrink-0">
          {item.price}
        </span>
      </div>
      <p class="text-xs text-stone-400 font-light leading-relaxed max-w-xl">
        {item.description}
      </p>
      {item.tags && item.tags.length > 0 && (
        <div class="flex gap-2 mt-2">
          {item.tags.map((tag) => (
            <span class="inline-block text-[9px] uppercase tracking-widest text-gold border border-gold px-2 py-[1px] rounded-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
      {unavailable && (
        <span class="inline-block mt-2 text-[9px] uppercase tracking-widest text-stone-500 border border-dashed border-stone-500 px-2 py-[1px] rounded-sm">
          Currently unavailable
        </span>
      )}
    </div>
</div>

<style>
  h3.featured .stamp {
    font-family: var(--font-body);
    font-size: 8px;
    color: var(--color-gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 1px 5px;
    border: 1px solid var(--color-gold);
    opacity: 0.85;
    transform: rotate(-2deg);
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
  }
</style>
