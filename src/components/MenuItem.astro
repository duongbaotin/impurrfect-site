---
import type { MenuItemData } from '../data/menu';
import cocktailPlaceholder from '../assets/images/cocktail-placeholder.svg?url';
import collinsGlass from '../assets/images/collins-glass.svg?url';
import coupeGlass from '../assets/images/coupe-glass.svg?url';
import highballGlass from '../assets/images/highball-glass.svg?url';
import rockGlass from '../assets/images/rock-glass.svg?url';
import shotGlass from '../assets/images/shot-glass.svg?url';
import tulipGlass from '../assets/images/tulip-glass.svg?url';
import chickenWingettes from '../assets/images/fried-chicken-wingettes-6pcs.webp?url';
import friedChips from '../assets/images/fried-chips.webp?url';
import grilledSausages from '../assets/images/grilled-sausages.webp?url';

const imageSrcMap: Record<string, string | undefined> = {
  '/cocktail-placeholder.svg': cocktailPlaceholder,
  '/collins-glass.svg': collinsGlass,
  '/coupe-glass.svg': coupeGlass,
  '/highball-glass.svg': highballGlass,
  '/rock-glass.svg': rockGlass,
  '/shot-glass.svg': shotGlass,
  '/tulip-glass.svg': tulipGlass,
  '/fried-chicken-wingettes-6pcs.webp': chickenWingettes,
  '/fried-chips.webp': friedChips,
  '/grilled-sausages.webp': grilledSausages,
};

interface Props {
  item: MenuItemData;
}

const { item } = Astro.props;
const unavailable = item.available === false;
const imgSrc = item.image ? imageSrcMap[item.image] : undefined;
const isPhoto = item.image?.endsWith('.webp') ?? false;
---

  <div class={`group font-body flex gap-4 items-center${unavailable ? ' opacity-50' : ''}`}>
    {imgSrc && (
      <div class="shrink-0">
        {isPhoto ? (
          <div x-data="{ open: false, activeSrc: '', loading: true }">
            <img src={imgSrc} alt=""
              class="w-20 sm:w-32 h-auto opacity-100 cursor-pointer transition-opacity hover:opacity-80"
              @click="open = true; activeSrc = $el.src" />

            <template x-teleport="body">
              <div x-show="open" x-cloak
                   x-transition.opacity.duration.150ms
                   x-init="$watch('open', val => { document.body.style.overflow = val ? 'hidden' : ''; if (val) loading = true; else activeSrc = '' })"
                   @click="open = false"
                   @keydown.escape.window="open = false"
                   role="dialog" aria-modal="true"
                   class="fixed inset-0 z-50 flex items-center justify-center bg-night/90">
                <div @click.stop class="relative flex items-center justify-center">
                  <div x-show="loading" class="absolute inset-0 flex items-center justify-center">
                    <div class="w-12 h-12 border-4 border-gold border-t-transparent rounded-full animate-spin"></div>
                  </div>
                  <button @click="open = false"
                          class="absolute -top-2 -right-2 text-cream text-3xl leading-none p-2 bg-night/50 rounded-full hover:text-gold transition-colors z-10"
                          aria-label="Close">&times;</button>
                  <img x-show="activeSrc.length" :src="activeSrc" @load="loading = false" @error="loading = false"
                       :class="['max-w-[90vw] max-h-[90vh] object-contain', loading ? 'opacity-0' : 'opacity-100']" />
                </div>
              </div>
            </template>
          </div>
        ) : (
          <img src={imgSrc} alt="" class="w-10 h-auto opacity-50" aria-hidden="true" />
        )}
      </div>
    )}
    <div class="flex-1 min-w-0">
      <div class="flex justify-between items-baseline gap-4 mb-1">
        <h3 class={`font-normal text-sm md:text-base transition-colors duration-200 tracking-wide${unavailable ? ' line-through text-stone-500' : ' text-cream group-hover:text-gold'}${item.featured && !unavailable ? ' featured' : ''}`}>
          {item.name}
          {item.featured && !unavailable && (
            <span class="stamp">staff favorite</span>
          )}
        </h3>
        <span class="flex-1 border-b border-dashed border-gold hidden sm:block"></span>
        <span class="font-display font-medium text-gold text-sm shrink-0">
          {item.price}
        </span>
      </div>
      <p class="text-xs text-stone-400 font-light leading-relaxed max-w-xl">
        {item.description}
      </p>
      {item.tags && item.tags.length > 0 && (
        <div class="flex gap-2 mt-2">
          {item.tags.map((tag) => (
            <span class="inline-block text-[9px] uppercase tracking-widest text-gold border border-gold px-2 py-[1px] rounded-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
      {unavailable && (
        <span class="inline-block mt-2 text-[9px] uppercase tracking-widest text-stone-500 border border-dashed border-stone-500 px-2 py-[1px] rounded-sm">
          Currently unavailable
        </span>
      )}
    </div>
</div>

<style>
  h3.featured .stamp {
    font-family: var(--font-body);
    font-size: 8px;
    color: var(--color-gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 1px 5px;
    border: 1px solid var(--color-gold);
    opacity: 0.85;
    transform: rotate(-2deg);
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
  }
</style>
