---
const isActive = (path: string) =>
  Astro.url.pathname === path || (path !== '/' && Astro.url.pathname.startsWith(path));

const linkClass = (path: string) =>
  `font-body text-xs tracking-widest uppercase no-underline transition-colors duration-200 ${
    isActive(path)
      ? 'text-cream'
      : 'text-stone-400 hover:text-cream'
  }`;

const linkAttrs = (path: string) => ({ class: linkClass(path), 'aria-current': isActive(path) ? 'page' as const : undefined });
---

<nav class="border-b border-charcoal">
  <div class="max-w-2xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-display text-cream text-lg tracking-widest no-underline">
      im<span class="font-accent italic text-gold">purr</span>fect
    </a>
    <div class="flex items-center gap-6">
      <a href="/menu" {...linkAttrs('/menu')}>Menu</a>
      <a href="/about" {...linkAttrs('/about')}>About</a>
      <a href="/contact" {...linkAttrs('/contact')}>Contact</a>
    </div>
  </div>
</nav>
