---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import MenuHeader from '../../components/MenuHeader.astro';
import MenuCategory from '../../components/MenuCategory.astro';
import { categories } from '../../data/categories';

const tagline = "Street-rescue cats, honest drinks, zero pretension.";

const items = await getCollection('menu');
items.sort((a, b) => a.data.order - b.data.order);

const menuCategories = categories
  .filter((cat) => cat.name !== 'Archived')
  .sort((a, b) => a.order - b.order)
  .map((cat) => ({
    category: cat.name,
    description: cat.description,
    items: items
      .filter((i) => i.data.category === cat.name)
      .map((i) => i.data),
  }));
---

<MainLayout title="menu - impurrfect" description="Explore our menu of honest concoctions and unpretentious drinks at impurrfect (a cat dive bar). Proper pours, fair prices, and a cat or two.">
  <MenuHeader tagline={tagline} />

  <div class="space-y-16">
    {menuCategories.map((cat) => (
      <MenuCategory category={cat} />
    ))}
  </div>
</MainLayout>
