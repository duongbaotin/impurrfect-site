---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import MenuHeader from '../../components/MenuHeader.astro';
import MenuCategory from '../../components/MenuCategory.astro';
import { categories } from '../../data/categories';
import type { MenuItemData } from '../../data/menu';

const tagline = "Embracing flaws, crafting perfection.";

const items = await getCollection('menu');
items.sort((a, b) => a.data.order - b.data.order);

const menuCategories = categories
  .sort((a, b) => a.order - b.order)
  .map((cat) => ({
    category: cat.name,
    description: cat.description,
    items: items
      .filter((i) => i.data.category === cat.name)
      .map((i) => i.data as MenuItemData),
  }));
---

<MainLayout title="menu - impurrfect" description="Explore our handcrafted cocktail menu at The Impurrfect Speakeasy. Signature cocktails and classic twists with a modern edge, crafted with meticulous attention to detail.">
  <MenuHeader tagline={tagline} />

  <div class="space-y-16">
    {menuCategories.map((cat) => (
      <MenuCategory category={cat} />
    ))}
  </div>
</MainLayout>
