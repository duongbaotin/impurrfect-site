---
import MainLayout from '../layouts/MainLayout.astro';
import HoursLocation from '../components/HoursLocation.astro';
---

<MainLayout title="contact - impurrfect" description="Get in touch with The Impurrfect Speakeasy. Find our location, hours, and how to reach us.">
  <section class="space-y-12">
    <div class="text-center space-y-4">
      <h1 class="font-display text-3xl md:text-4xl tracking-widest text-cream uppercase">
        Contact
      </h1>
      <div class="h-[1px] w-16 bg-gold mx-auto"></div>
    </div>

    <div class="space-y-8 font-body text-sm">
      <HoursLocation />

      <div class="border border-charcoal rounded-sm p-6">
        <p class="text-stone-400 leading-relaxed">
          For private events, reservations, or general inquiries, please reach out via email. We'll respond within 24 hours.
        </p>
      </div>
    </div>

    <div class="text-center pt-4">
      <a
        href="/menu"
        class="inline-block bg-gold text-cream font-medium px-6 py-3 rounded-sm hover:bg-gold-dark transition-colors duration-200 text-sm tracking-wide uppercase"
      >
        View Our Menu
      </a>
    </div>
  </section>
</MainLayout>
