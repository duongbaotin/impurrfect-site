---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import MenuHeader from '../../components/MenuHeader.astro';
import PreviewThemeToggle from '../../components/preview/PreviewThemeToggle.astro';
import PreviewFilterBar from '../../components/preview/PreviewFilterBar.astro';
import PreviewMenuCategory from '../../components/preview/PreviewMenuCategory.astro';
import { categories } from '../../data/categories';
import { menuMoods, moodKeysFor } from '../../data/menu-moods';
import '../../styles/menu-preview.css';

// Staging mirror of /menu: Baserow data + the preview-only UX upgrades.
// Unlinked from the nav and noindexed until the production cutover (Phase 4).

const tagline = 'Street-rescue cats, honest drinks, zero pretension.';

const items = await getCollection('menuBaserow');
items.sort((a, b) => a.data.order - b.data.order);

const menuCategories = categories
  .filter((cat) => cat.name !== 'Archived')
  .sort((a, b) => a.order - b.order)
  .map((cat) => ({
    category: cat.name,
    description: cat.description,
    items: items
      .filter((i) => i.data.category === cat.name)
      .map((i) => ({
        ...i.data,
        // order is unique within a category (schema + build guard), so this is stable.
        key: `${cat.name}/${i.data.order}/${i.data.name}`,
      })),
  }))
  .filter((cat) => cat.items.length > 0);

const previewItems = menuCategories.flatMap((cat) =>
  cat.items.map((item) => ({
    key: item.key,
    category: cat.category,
    subcategory: item.subcategory ?? null,
    moods: moodKeysFor(item),
  }))
);

const categoryTabs = menuCategories.map((cat) => ({
  name: cat.category,
  count: cat.items.length,
}));
---

<MainLayout
  title="menu preview - impurrfect"
  description="Staging preview of the impurrfect menu, generated from Baserow at build time."
  noindex={true}
  preview={true}
>
  <div
    class="menu-preview"
    x-data="menuPreview"
    data-items={JSON.stringify(previewItems)}
    data-moods={JSON.stringify(menuMoods)}
  >
    <MenuHeader tagline={tagline} compact={true} />

    <div class="pv-control-bar mb-6 flex justify-end">
      <PreviewThemeToggle />
    </div>

    <PreviewFilterBar categories={categoryTabs} moods={menuMoods} />

    <div id="preview-menu-list" class="mt-8 space-y-14">
      {menuCategories.map((cat) => (
        <PreviewMenuCategory category={cat} />
      ))}
    </div>

    <div
      class="pv-empty mt-8 rounded-sm p-6 text-center font-body text-xs"
      x-show="visibleCount === 0"
      x-cloak
    >
      <p>No drinks match this filter.</p>
      <button type="button" class="pv-clear mt-2" @click="clearFilters()">
        Clear filter
      </button>
    </div>
  </div>
</MainLayout>
