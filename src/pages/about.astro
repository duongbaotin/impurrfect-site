---
import MainLayout from '../layouts/MainLayout.astro';
import BrandNameWord from '../components/BrandNameWord.astro';
---

<MainLayout title="about - impurrfect" description="Discover the story behind impurrfect (a cat dive bar) — where wabi-sabi philosophy meets honest drinks and street-rescue cats.">
  <section class="space-y-12">
    <div class="text-center space-y-4">
      <h1 class="font-display text-3xl md:text-4xl tracking-widest text-cream">
        our story
      </h1>
      <div class="h-[1px] w-16 bg-gold mx-auto"></div>
    </div>

    <div class="space-y-6 font-body text-sm text-stone-400 leading-relaxed">
      <p>
        <span class="font-display text-cream"><BrandNameWord /></span> was born from a simple belief: perfection is overrated. Inspired by the Japanese philosophy of <span class="font-accent italic text-cream">wabi-sabi</span> — finding beauty in imperfection, transience, and the incomplete — our dive bar is a sanctuary for the flawed, the unconventional, and the honest.
      </p>
      <p>
        Tucked away from the city's rush, we invite you to leave your expectations at the door. Our drinks are proper, but they aren't precious: smokey and sweet, bitter and bright, familiar yet unexpected. Our bartenders make them with genuine care, and a drink's character lives in its little imperfections.
      </p>
      <p>
        The cracked ceramic holds more stories than the pristine one. The slightly uneven pour carries more soul. Here, we celebrate the beauty of what's broken, battered, and beautifully imperfect.
      </p>
    </div>

    <div class="text-center pt-4">
      <a
        href="/menu"
        class="inline-block bg-gold text-cream font-medium px-6 py-3 rounded-sm hover:bg-gold-dark transition-colors duration-200 text-sm tracking-wide uppercase"
      >
        View Our Menu
      </a>
    </div>
  </section>
</MainLayout>
