{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/bar-menu",
      "destination": "/menu",
      "permanent": true
    },
    {
      "source": "/bar-menu/:path*",
      "destination": "/menu/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/ops-finance",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/ops-finance/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
